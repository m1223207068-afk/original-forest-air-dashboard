# Copy this file to .env and fill in your real values.
# The dashboard reads .env automatically when server.py starts.

WST_USER=你的沃斯彤账号
WST_PASS=你的沃斯彤密码

# Admin password for changing WST credentials from the web page.
# Required on cloud hosting. If empty, credential switching only works from localhost.
ADMIN_TOKEN=请设置一个管理口令

# Weather provider: open_meteo needs no key; amap uses AMAP_KEY.
WEATHER_PROVIDER=open_meteo

# Open-Meteo coordinates, default is Hangzhou Linping.
WEATHER_LATITUDE=30.42
WEATHER_LONGITUDE=120.30
WEATHER_CITY_NAME=浙江 杭州临平

# Visitor IP weather: ipwhois needs no key and is used by /weather.
# If IP lookup fails, the dashboard falls back to the coordinates above.
IP_WEATHER_PROVIDER=ipwhois

# Amap Web Service API Key. Optional when WEATHER_PROVIDER=open_meteo.
# Apply at: https://console.amap.com/dev/key/app
AMAP_KEY=你的高德Web服务Key

# Hangzhou Linping District by default.
AMAP_CITY=330113
WEATHER_INTERVAL=600
